{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoguard.local/contracts/incident.signals.v1.schema.json",
  "title": "EchoGuard incident candidate signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "signal_id", "tenant_id", "trace_id", "signal_key", "product", "window_start", "window_end", "detected_time", "current_count", "baseline_count", "ratio", "distinct_customers", "sample_event_ids", "rule_version"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "signal_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "signal_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "product": {"type": "string", "minLength": 1, "maxLength": 128},
    "error_code": {"type": ["string", "null"], "maxLength": 128},
    "window_start": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
    "window_end": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
    "detected_time": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
    "current_count": {"type": "integer", "minimum": 0},
    "baseline_count": {"type": "number", "minimum": 0},
    "ratio": {"type": "number", "minimum": 0},
    "distinct_customers": {"type": "integer", "minimum": 0},
    "sample_event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "maxItems": 100},
    "rule_version": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}

